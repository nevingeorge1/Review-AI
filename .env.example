# ==============================================================================
# ReviewAI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment (development, staging, production, testing)
APP_ENV=development

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Backend API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Source Code Input Constraints & Safety Limits
MAX_SOURCE_LINES=500
MAX_SOURCE_SIZE=65536

# Static Code Analysis Configuration
ENABLE_STATIC_ANALYSIS=true
ENABLE_RUFF=true
ENABLE_BANDIT=true
ENABLE_AST_RULES=true
STATIC_ANALYZER_TIMEOUT=15
ENABLED_ANALYZERS=["ast","ruff","bandit"]

# Static Analysis Rule Thresholds
MAX_FUNCTION_COMPLEXITY=10
MAX_NESTING_DEPTH=4
MAX_FUNCTION_PARAMETERS=6
STATIC_CONTEXT_LINES=2

# LLM Reasoning Layer Configuration
# Local-First Architecture: Defaults to local Ollama instance
ENABLE_LLM=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=2

# Static-Only Fallback Mode:
# When true, the system gracefully operates on static analysis alone if LLM is unavailable
ALLOW_STATIC_FALLBACK=true

# Storage Repository Configuration
# Supported types: in_memory, sqlite (future), postgresql (future)
STORAGE_TYPE=in_memory
STORAGE_DATABASE_URL=sqlite:///./reviewai.db

# Telemetry and Observability
ENABLE_METRICS=true
RECORD_STAGE_TIMINGS=true
